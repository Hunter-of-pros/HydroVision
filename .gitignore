# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.venv/
venv/
ENV/
env/
.env
.env.local

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
dist/
.vite/
.DS_Store

# Artifacts & Heavy Data (Keep .gitkeep)
*.tif
*.tiff
*.tar.gz
*.gz
artifacts/models/*.pt
artifacts/models/*.pth
artifacts/models/*.onnx
artifacts/data/*.npz
artifacts/data/*.tif
artifacts/data/*.tiff
artifacts/reports/*.png
artifacts/reports/*.pdf
!artifacts/models/.gitkeep
!artifacts/data/.gitkeep
!artifacts/reports/.gitkeep

# IDEs
.idea/
.vscode/
*.swp

# Track specific model artifacts and reports despite the ignore rules above
!artifacts/models/best.pt
!artifacts/models/baseline.pt
!artifacts/models/normalizer.json
!artifacts/data/terrain.npz
!artifacts/reports/*.json
!artifacts/reports/dem.png
!artifacts/reports/dem_candidates.png
!artifacts/reports/solver_real_terrain.png
!artifacts/reports/baseline_rollout_error.png

